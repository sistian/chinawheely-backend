# Example environment variables for Chinawheely Vercel backend
# Copy these values into the Vercel dashboard: Project Settings → Environment Variables.

# Required: SendGrid API key
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: verified sender address in SendGrid (default may be rejected by mail providers)
SENDGRID_FROM_EMAIL=noreply@chinawheely.com

# Optional: email address that receives booking submissions (default: 15527771775@qq.com)
RECIPIENT_EMAIL=15527771775@qq.com

# Optional: where to redirect after a successful booking (default: /thank-you.html)
# Use an absolute URL when the frontend is deployed on a different domain than this API.
SUCCESS_URL=https://www.chinawheely.com/thank-you.html

# Optional: form field name used as reply-to (default: email)
REPLY_TO_FIELD=email

# Optional: comma-separated list of allowed frontend origins for CORS.
# Use '*' to allow all origins, or list your domains, e.g.:
# ALLOWED_ORIGINS=https://www.chinawheely.com,https://beijing.chinawheely.com
ALLOWED_ORIGINS=*
